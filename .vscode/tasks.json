{
  // VS Code tasks виконуються з кореня workspace у devcontainer terminal.
  // Тут лишаються тільки базові команди: configure/build і clean.
  "version": "2.0.0",
  "tasks": [
    {
      // Default build task: Ctrl+Shift+B запускає debug preset, потім build.
      "label": "CMake: configure and build",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      // Default build task: Ctrl+Shift+B запускає debug preset, потім build.
      "label": "CMake: configure and build release with debug info",
      "type": "shell",
      "command": "cmake --preset reldeb && cmake --build --preset reldeb",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CMake: configure and build release",
      "type": "shell",
      "command": "cmake --preset release && cmake --build --preset release",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CMake: configure and build debug with sanitaze",
      "type": "shell",
      "command": "cmake --preset sanitizer && cmake --build --preset sanitizer",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CMake: run sanitazer homework_05",
      "type": "shell",
      "command": "LSAN_OPTIONS=verbosity=1:log_threads=1 ASAN_OPTIONS=detect_leaks=1 ./build/debug/sanitize/homework_05/telemetry_check ${workspaceFolder}/homework_05/data/good.txt",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CMake: run valgrind homework_05",
      "type": "shell",
      "command": "valgrind --tool=memcheck --leak-check=full ./build/debug/sanitize/homework_05/telemetry_check ${workspaceFolder}/homework_05/data/good.txt",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      // Default build task: Ctrl+Shift+B запускає debug preset, потім build.
      "label": "CMake: configure and build ballistic_cli",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug --target ballistics_cli --target ballistics_tests",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CMake: run sanitazer homework_06",
      "type": "shell",
      "command": "LSAN_OPTIONS=verbosity=1:log_threads=1 ASAN_OPTIONS=detect_leaks=1 ./build/debug/sanitize/homework_06/ballistics_cli ${workspaceFolder}/homework_06/data/good.txt",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
