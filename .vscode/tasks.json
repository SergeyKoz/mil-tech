    {
      "label": "CMake: configure and build underground_world",
      "type": "shell",
      "command": "cd ${workspaceFolder}/homework_14/robot_ws && colcon build --symlink-install --packages-select underground_world --cmake-args -DCMAKE_BUILD_TYPE=Debug",
      "group": {
        "kind": "build",
        "isDefault": true
