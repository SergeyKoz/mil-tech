    },
    {
      "label": "CMake: run valgrind homework_06",
      "type": "shell",
      "command": "valgrind --tool=memcheck --leak-check=full ./build/debug/sanitize/homework_06/ballistics_cli ${workspaceFolder}/homework_06/data/good.txt",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      // Clean task навмисно простий: видаляється тільки локальна build директорія.
      "label": "CMake: clean build directory",
      "type": "shell",
      "command": "rm -rf build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CMake: clang-tidy: analyze homework_06 project",
      "type": "shell",
      "command": "run-clang-tidy -p build/debug 'homework_06/(src|include|tests)/.*\\.(cpp|cc|cxx|h|hpp)$'",
      "group": "test",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
