{
    "version": "2.0.0",
    "tasks": [       
        {
            "label": "CMake: configure and build ballistics_simulator",
            "type": "shell",
            "command": "cd ${workspaceFolder}/robot_ws && colcon build --symlink-install --packages-select ballistics_simulator --cmake-args -DCMAKE_BUILD_TYPE=Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },        
    ]
}