{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build для занять блоку 2: символи для GDB і зрозуміла структура build/debug.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "reldeb",
      "displayName": "Release with Debug Info",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitizer",
      "displayName": "Sanitizer",
      "description": "Sanitizer build build/debug/sanitize.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug/sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "aarch64-debug",
      "displayName": "ARM64 Debug",
      "description": "Cross-compile debug build для Raspberry Pi / Radxa / Jetson через aarch64-linux-gnu toolchain.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/aarch64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu.cmake"
      }
    }
  ],
  "buildPresets": [    
    {
      "name": "debug",
      "displayName": "Build Debug",
      "description": "Зібрати debug preset після configure.",
      "configurePreset": "debug"
    },
    {
      "name": "reldeb",
      "displayName": "Build Debug",
      "description": "Build debug preset after configure.",
      "configurePreset": "reldeb"
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "description": "Build release preset after configure.",
      "configurePreset": "release"
    },
    {
      "name": "sanitizer",
      "displayName": "Build wit Sanitizer",
      "description": "Зібрати Sanitize debug preset після configure.",
      "configurePreset": "sanitizer"
    },
    {
      "name": "aarch64-debug",
      "displayName": "Build ARM64 Debug",
      "description": "Зібрати ARM64 debug preset після cross-configure.",
      "configurePreset": "aarch64-debug"
    }
  ]
}
